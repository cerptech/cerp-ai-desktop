# CERP Backend
CERP_API_BASE_URL=http://localhost:8080/api

# CERP IA service (biblioteca de prompts preparados). Default: producción.
# Staging está detrás de Vercel Auth (302): el Desktop usa su respaldo local.
# CERP_AI_SERVICE_URL=https://cerp-ai-service.vercel.app

# Auth0 (Native application)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-native-app-client-id
AUTH0_AUDIENCE=https://your-api-identifier

# Development only (bypass Auth0 for testing)
# DEV_API_KEY=sk-ant-...
